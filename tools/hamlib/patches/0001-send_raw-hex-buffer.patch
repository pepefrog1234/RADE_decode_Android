send_raw: keep the hex bytes inside their buffer

parse_hex() is given the size of its output buffer and ignored it: a client
could write as many bytes of its choosing as it sent past send[200] on the
stack. (A byte it could not parse was stored from an unset variable.)

Still in Hamlib 4.7.2, which fixed the other send_raw overflows
(CVE-2026-54634).

diff --git a/tests/rigctl_parse.c b/tests/rigctl_parse.c
--- a/tests/rigctl_parse.c
+++ b/tests/rigctl_parse.c
@@ -5897,7 +5897,7 @@ static int parse_hex(const char *s, unsigned char *buf, int len)
 
     while (p)
     {
-        unsigned int val;
+        unsigned int val = 0;
         int n;
 
         if ((n = sscanf(p, "0x%2x", &val)) != 1)
@@ -5911,6 +5911,16 @@ static int parse_hex(const char *s, unsigned char *buf, int len)
                       __func__, s);
         }
 
+        /* [RADE] The client decides how many bytes there are, the caller
+         * how many fit. */
+        if (i >= len)
+        {
+            rig_debug(RIG_DEBUG_ERR, "%s: more than %d bytes in '%s'\n",
+                      __func__, len, s);
+            free(s2);
+            return -1;
+        }
+
         buf[i++] = val;
         p = strtok(NULL, ";:");
     }
@@ -5978,6 +5988,12 @@ declare_proto_rig(send_raw)
     if (strncmp(arg2, "0x", 2)  == 0 || arg2[0] == 'x')
     {
         arg2_len = parse_hex(arg2, send, sizeof(send));
+
+        if (arg2_len < 0)
+        {
+            return -RIG_EINVAL;
+        }
+
         sendp = send;
         is_binary = 1;
     }
